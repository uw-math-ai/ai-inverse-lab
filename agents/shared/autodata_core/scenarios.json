{
 "_comment": "Scenario corpus for the autodata agents (JSON copy of Toggable Simulation of Data Code/configs/autodata_scenarios.yaml). Each scenario is a brief plus a base fptsim spec; families lists alternatives the challenger may switch to.",
 "scenarios": [
  {
   "id": "paper8_ladder",
   "brief": "The paper's Fig. 1 setting: a 2 x 4 ladder observed on three top vertices. Recover the centrality of the remaining vertices; make it non-trivial (not a constant or degree law).",
   "base_spec": {
    "graphs": {
     "families": {
      "ladder": {
       "length": 4
      }
     },
     "weights": {
      "dist": "constant",
      "value": 0.25
     },
     "mu": {
      "mode": "constant",
      "value": 1.0
     },
     "B": {
      "mode": "explicit",
      "vertices": [
       1,
       2,
       3
      ]
     }
    },
    "simulation": {
     "T": 9,
     "T_mode": "paper",
     "N": 20000
    }
   },
   "families": [
    {
     "ladder": {
      "length": [
       4,
       7
      ]
     }
    }
   ]
  },
  {
